{
  "name": "spa-soluciones-radicales",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "db:check": "node scripts/database/check-migrations.mjs",
    "db:status": "npx -y neon@6.2.4 status",
    "db:diff": "npx -y neon@6.2.4 diff",
    "db:psql": "npx -y neon@6.2.4 psql",
    "db:migrate": "node scripts/database/migrate.mjs",
    "db:bootstrap": "node scripts/database/bootstrap.mjs",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "cloudflare:dev": "npm run build && npx wrangler dev",
    "cloudflare:deploy": "npm run build && npx wrangler deploy",
    "r2:cors:apply": "npx wrangler r2 bucket cors set sr-master-files --file cloudflare/r2-master-cors.json",
    "r2:cors:check": "npx wrangler r2 bucket cors list sr-master-files"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/functions": "^0.11.0",
    "@neondatabase/auth": "^0.5.0-beta",
    "@xmldom/xmldom": "0.9.12",
    "docxtemplater": "3.71.0",
    "hono": "^4.13.13",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "lucide-vue-next": "^1.0.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "pinia": "^4.0.3",
    "pizzip": "3.3.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "~10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
