# Variables públicas de la SPA. Pueden exponerse en el bundle de Vite.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
VITE_NEON_FUNCTION_URL=

# Solo procesos de servidor/CLI. Nunca usar DATABASE_URL desde código ejecutado en el navegador.
DATABASE_URL=

# Neon Function. Los valores se cargan desde un archivo local ignorado y se publican como secretos del runtime.
ALLOWED_ORIGINS=http://localhost:5173
# Opcional; recomendado cuando hay más de un dominio web. Origen exacto HTTPS incluido en ALLOWED_ORIGINS.
CALENDAR_APP_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Cloudflare R2: solo backend/Functions/Workers. Nunca usar prefijo VITE_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MASTER_FILES=sr-master-files
R2_BUCKET_SERVICE_MEDIA=sr-service-media
R2_BUCKET_GENERATED_DOCUMENTS=sr-generated-documents
